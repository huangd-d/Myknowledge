{
  "name": "my-knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check:rules": "node scripts/check-frontend-rules.mjs src",
    "verify": "npm run typecheck && npm run check:rules",
    "verify:full": "npm run typecheck && npm run lint && npm run format:check && npm run check:rules"
  },
  "dependencies": {
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
